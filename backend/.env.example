# Jalankan npm run setup untuk membuat backend/.env dengan secret acak.
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@localhost:5432/himti_musik
SESSION_SECRET=DIISI_OTOMATIS_OLEH_NPM_RUN_SETUP
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Untuk hosting di balik SATU reverse proxy tepercaya, isi 1.
TRUST_PROXY=0
# Aktifkan untuk database remote yang membutuhkan TLS. Sertifikat tetap diverifikasi.
PG_SSL=false
